# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local data
/.data
/public/uploads
*.db
_backups/
.playwright-mcp/
test-results/
playwright.config.ts

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Debug screenshots from Playwright sessions
*.png
supabase/.temp/

# email blast runtime lock (created/removed by scripts/email-blast.mjs)
scripts/.email-blast.lock
